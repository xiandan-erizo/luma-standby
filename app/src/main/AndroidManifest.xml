<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Permissions are opt-in and small on purpose.

      INTERNET is only used by the weather widget, and only while that widget is
      placed. The notification listener is declared but the OS will not start it
      until the user grants notification access in Settings; the app never asks for
      that at first launch.

      v0.1 still requests nothing at install time: all of the above are normal or
      signature permissions, not runtime prompts.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.LumaStandby">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".StandbyActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:showWhenLocked="true"
            android:theme="@style/Theme.LumaStandby.Standby"
            android:turnScreenOn="true" />

        <!--
          Optional: only runs after the user grants notification access. Powers the
          "latest notification" and "now playing" widgets.
        -->
        <service
            android:name=".platform.widgets.LumaNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          DreamService is intentionally NOT registered on HyperOS 4 builds: the
          Settings screen-saver preview path crashes system_server
          (ActivityTaskManagerService.startDreamActivityLocked NPE, see
          docs/known-issues.md). The implementation is kept in
          dream/LumaDreamService.kt plus res/xml/luma_dream.xml so other ROMs can
          re-enable it - docs/dream-service.md has the exact block to paste back.
        -->
    </application>

</manifest>
